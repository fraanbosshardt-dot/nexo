# Copiá este archivo como .env y completá los valores. El .env nunca se sube a GitHub.

# Base de datos PostgreSQL.
# Local (sin Docker): npm run db:local levanta PostgreSQL en el puerto 5434 con esta URL.
# Railway: copiá la variable DATABASE_URL del servicio Postgres (pestaña Variables).
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/postgres?sslmode=disable"

# Clave secreta de 32 bytes en base64 para cifrar los secretos de la verificación en dos pasos.
# Generala con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# URL pública de la app (en Vercel, la URL del proyecto).
APP_URL="http://localhost:3000"

# ---------- Opcional: se activa cargando la clave ----------

# Emails (recuperar contraseña y avisos de vencimientos) con https://resend.com
# Sin clave, en desarrollo el email se muestra en la consola del servidor.
RESEND_API_KEY=""
EMAIL_FROM="NEXO <avisos@tudominio.com>"

# Tarea diaria (cotizaciones y avisos). Vercel Cron la llama con este secreto.
CRON_SECRET=""

# Cobro de Pro con Mercado Pago (suscripciones). Precios en la moneda de MP_CURRENCY.
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
MP_CURRENCY="ARS"
MP_PRICE_MONTHLY=""
MP_PRICE_YEARLY=""
# En Mercado Pago, configurá la notificación (webhook) a: <APP_URL>/api/pagos/mercadopago
# con los eventos "Planes y suscripciones".

# Ingresar con Google. En Google Cloud → APIs y servicios → Credenciales → ID de cliente OAuth (aplicación web).
# URI de redirección autorizado: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Administradores del panel interno (/admin), separados por coma. También: npm run admin -- tu@email.com
ADMIN_EMAILS=""

# Lecturas de PDF de resumen por mes, por espacio (solo Pro). Se lee en el servidor, sin IA ni costo.
PDF_MONTHLY_LIMIT="5"
